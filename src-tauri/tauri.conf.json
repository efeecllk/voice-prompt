{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Prompt",
  "version": "../package.json",
  "identifier": "com.voiceprompt.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Voice Prompt",
        "label": "main",
        "width": 360,
        "height": 480,
        "resizable": false,
        "decorations": true,
        "visible": false,
        "alwaysOnTop": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDMTFDMjc4QjQ5OTFDNTUKUldSVkhKbTBlTUlSbkhMVlRHdENKcXhTSlU0eCt6WmFDQ0RIdWJiUU5ocHJleFNhNXdJUW5tOFYK",
      "endpoints": [
        "https://github.com/efeecllk/voice-prompt/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/shared/32x32.png",
      "icons/shared/128x128.png",
      "icons/shared/128x128@2x.png",
      "icons/shared/256x256.png",
      "icons/shared/512x512.png",
      "icons/shared/icon.png",
      "icons/macos/icon.icns",
      "icons/windows/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "./entitlements.plist",
      "infoPlist": "./Info.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "./icons/windows/icon.ico",
        "displayLanguageSelector": false,
        "startMenuFolder": "Voice Prompt",
        "minimumWebview2Version": "110.0.1531.0"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libappindicator3-1", "libasound2t64 | libasound2"],
        "recommends": ["xdotool", "wtype"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
